<div class="break-roll-dialog">
    {{#if aptitude}}
    <label class="roll-type-select">{{localize "BREAK.RollType"}}
        <select name="rollType" {{#if limited}}disabled{{/if}}>
            <option value="0" {{#unless defaultContest}}selected{{/unless}}>{{localize "BREAK.Check"}}</option>
            <option value="1" {{#if defaultContest}}selected{{/if}}>{{localize "BREAK.Contest"}}</option>
        </select>
    </label>
    {{/if}}
    <fieldset class="roll-participant">
        <legend>{{localize "BREAK.Roll"}}</legend>
        <label>{{localize "BREAK.Edge"}}
            <select name="edge">
                <option value="">{{localize "BREAK.None"}}</option>
                <option value="1" {{#when defaultEdge 'eq' '1'}}selected{{/when}}>{{localize "BREAK.Edge"}}</option>
                <option value="2" {{#when defaultEdge 'eq' '2'}}selected{{/when}}>{{localize "BREAK.Snag"}}</option>
            </select>
        </label>
        <label>{{localize "BREAK.Bonus"}}
            <select name="bonus">
                <option value="">{{localize "BREAK.None"}}</option>
                <option value="{{bonuses.MINOR_BONUS}}" {{#when defaultBonus 'eq' bonuses.MINOR_BONUS}}selected{{/when}}>{{localize "BREAK.MinorBonus"}}</option>
                <option value="{{bonuses.MAJOR_BONUS}}" {{#when defaultBonus 'eq' bonuses.MAJOR_BONUS}}selected{{/when}}>{{localize "BREAK.MajorBonus"}}</option>
                <option value="{{bonuses.MINOR_PENALTY}}" {{#when defaultBonus 'eq' bonuses.MINOR_PENALTY}}selected{{/when}}>{{localize "BREAK.MinorPenalty"}}</option>
                <option value="{{bonuses.MAJOR_PENALTY}}" {{#when defaultBonus 'eq' bonuses.MAJOR_PENALTY}}selected{{/when}}>{{localize "BREAK.MajorPenalty"}}</option>
            </select>
        </label>
        <label>{{localize "BREAK.CustomBonus"}}<input name="customBonus" type="number"></label>
    </fieldset>
    {{#if opposedControls}}
    <fieldset class="roll-participant contest-opponent" hidden>
        <legend>{{localize "BREAK.CONTEST.Opponent"}}: <span data-opponent-name></span></legend>
        <label class="roll-aptitude-select">{{localize "BREAK.Aptitudes"}}<select name="opponentAptitude" disabled></select></label>
        <label>{{localize "BREAK.Edge"}}
            <select name="opponentEdge" disabled>
                <option value="">{{localize "BREAK.None"}}</option>
                <option value="1">{{localize "BREAK.Edge"}}</option>
                <option value="2">{{localize "BREAK.Snag"}}</option>
            </select>
        </label>
        <label>{{localize "BREAK.Bonus"}}
            <select name="opponentBonus" disabled>
                <option value="">{{localize "BREAK.None"}}</option>
                <option value="{{bonuses.MINOR_BONUS}}">{{localize "BREAK.MinorBonus"}}</option>
                <option value="{{bonuses.MAJOR_BONUS}}">{{localize "BREAK.MajorBonus"}}</option>
                <option value="{{bonuses.MINOR_PENALTY}}">{{localize "BREAK.MinorPenalty"}}</option>
                <option value="{{bonuses.MAJOR_PENALTY}}">{{localize "BREAK.MajorPenalty"}}</option>
            </select>
        </label>
        <label>{{localize "BREAK.CustomBonus"}}<input name="opponentCustomBonus" type="number" disabled></label>
    </fieldset>
    {{/if}}
</div>
