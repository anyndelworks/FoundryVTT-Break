<div class="flexcol" style="width:100%;gap:10px;">
    {{#if showCurrency}}
        <div class="section-header">{{localize "BREAK.Currency"}}</div>
        <div style="display:flex;align-items:center;justify-content:center;flex-grow:0;margin-bottom:6px;">
            <i class="fas fa-gem"></i>
            <input name="system.currency.gems" value="{{document.system.currency.gems}}" placeholder="0" class="money-input" type="number" />
            <i class="fas fa-coins"></i>
            <input name="system.currency.coins" value="{{document.system.currency.coins}}" placeholder="0" class="money-input" type="number" />
            <i class="fas fa-cubes-stacked"></i>
            <input name="system.currency.stones" value="{{document.system.currency.stones}}" placeholder="0" class="money-input" type="number" />
        </div>
    {{/if}}

    <div data-container-drop data-container-id="">
        <div class="section-header">
            {{localize "BREAK.CONTAINER.BaseInventory"}}
            <span style="margin-left:auto;">{{usedInventorySlots}} / {{inventorySlots}} | {{localize "BREAK.CONTAINER.Access.free"}}</span>
            <a class="add-item-custom" data-action="addCustomItem" style="margin-left:8px;"><i class="fa-regular fa-plus"></i></a>
        </div>
        {{#each bagContent as |item|}}
            {{> "systems/break/templates/actors/shared/inventory-item-row.hbs" item=item}}
        {{/each}}
    </div>

    {{#each inventoryContainers as |container|}}
        <div data-container-drop data-container-id="{{container.id}}" style="border:1px solid grey;padding:4px;">
            <div class="section-header">
                {{container.name}}
                <span {{#when container.usedSlots 'gt' container.capacity}}style="margin-left:auto;color:red;"{{else}}style="margin-left:auto;"{{/when}}>
                    {{container.usedSlots}} / {{container.capacity}} | {{container.accessCostLabel}}
                </span>
            </div>
            <p style="margin:2px 4px;font-size:12px;">
                {{#if container.unrestricted}}{{localize "BREAK.CONTAINER.AnyItem"}}{{else}}{{localize "BREAK.CONTAINER.Allowed"}}: {{container.allowedLabels}}{{/if}}
            </p>
            {{#each container.items as |item|}}
                {{> "systems/break/templates/actors/shared/inventory-item-row.hbs" item=item}}
            {{/each}}
        </div>
    {{/each}}
</div>
